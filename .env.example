# ══════════════════════════════════════════════════════════════════════
#  RAGbase — Environment Configuration
#  Copy this file to .env and fill in your values.
#
#  Phase 1 (Search + Embed only — NO LLM):
#    Required: GITHUB_TOKEN, GITHUB_REPOS
#    Optional: ES_URL (defaults to localhost)
#    Leave: OPENAI_API_KEY blank, LLM_PROVIDER=none
#
#  Phase 2 (Full RAG with LLM answers):
#    Required: everything above + OPENAI_API_KEY
#    Set:      LLM_PROVIDER=openai, INGEST_USE_LLM=true
# ══════════════════════════════════════════════════════════════════════

# ── GitHub ────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here
# Comma-separated list of owner/repo
GITHUB_REPOS=your-org/your-docusaurus-repo

# ── Docusaurus repo layout ────────────────────────────────────────────
# Subfolder inside repo that contains markdown docs
DOCUSAURUS_DOCS_PATH=docs
DOCUSAURUS_INCLUDE_BLOG=false
GITHUB_INCLUDE_IMAGES=true
GITHUB_MAX_FILE_SIZE_KB=500

# ── Elasticsearch ─────────────────────────────────────────────────────
ES_URL=http://localhost:9200
ES_INDEX=ragbase_docs

# ── Embedding provider ────────────────────────────────────────────────
# "openai"  → text-embedding-3-large (best quality, requires OPENAI_API_KEY)
# "local"   → all-MiniLM-L6-v2 via sentence-transformers (free, offline)
EMBED_PROVIDER=local
OPENAI_EMBED_DIMS=3072
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── LLM provider (optional — leave as "none" for Phase 1) ────────────
# "openai"  → GPT-4o answers
# "none"    → disables /api/query; only /api/search works
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# ── Ingestion mode ────────────────────────────────────────────────────
# false → Phase 1: raw markdown directly chunked (no LLM calls)
# true  → Phase 2: LLM enriches artifacts before chunking
INGEST_USE_LLM=false

# ── Retrieval tuning ──────────────────────────────────────────────────
ES_KNN_CANDIDATES=100
RETRIEVAL_RERANK_TOP_N=5
CHUNK_SIZE=512
CHUNK_OVERLAP=52
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Frontend ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
